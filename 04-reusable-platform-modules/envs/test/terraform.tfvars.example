prefix        = "tfaz04"
location      = "eastus"
owner         = "your-name"
address_space = ["10.45.0.0/16"]

subnets = {
  web = {
    address_prefixes = ["10.45.1.0/24"]
    inbound_rules = [
      {
        name                   = "AllowHttpsFromCorp"
        priority               = 100
        protocol               = "Tcp"
        source_address_prefix  = "10.0.0.0/8"
        destination_port_range = "443"
      }
    ]
  }

  app = {
    address_prefixes = ["10.45.2.0/24"]
    inbound_rules = [
      {
        name                   = "AllowAppFromWeb"
        priority               = 100
        protocol               = "Tcp"
        source_address_prefix  = "10.45.1.0/24"
        destination_port_range = "8080"
      }
    ]
  }

  data = {
    address_prefixes = ["10.45.3.0/24"]
    inbound_rules = [
      {
        name                   = "AllowDbFromApp"
        priority               = 100
        protocol               = "Tcp"
        source_address_prefix  = "10.45.2.0/24"
        destination_port_range = "5432"
      }
    ]
  }
}

enable_diagnostics = false

